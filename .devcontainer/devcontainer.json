{
  "name": "yotogi-compe",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "containerEnv": {
    "ADMIN_TOKEN": "dev-admin",
    "HASH_SECRET": "dev-secret"
  },
  "postCreateCommand": "cd web && npm install",
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": { "label": "コンペサイト", "onAutoForward": "openBrowser" },
    "5173": { "label": "開発用画面（npm run dev）", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
