{
  "name": "yotogi-compe",
  "image": "mcr.microsoft.com/devcontainers/go:1",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "containerEnv": {
    "ADMIN_TOKEN": "dev-admin",
    "HASH_SECRET": "dev-secret"
  },
  "postCreateCommand": "cd web && npm install && npm run build",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "コンペサイト", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
